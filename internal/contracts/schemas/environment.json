{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sandbox", "agents", "modelBindings"],
  "properties": {
    "schemaVersion": {"const": "turnyard.environment/v1"},
    "sandbox": {"type": "object", "additionalProperties": false, "required": ["backend", "image"], "properties": {
      "backend": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
      "image": {"type": "string", "minLength": 1},
      "cpus": {"type": "integer", "minimum": 1, "maximum": 16},
      "memoryMB": {"type": "integer", "minimum": 256, "maximum": 32768},
      "network": {"enum": ["default", "none", "model-only"]},
      "isolation": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}
    }},
    "agents": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "runtime", "modelBinding"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "runtime": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}, "modelBinding": {"type": "string", "minLength": 1},
        "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "delegates": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}, "uniqueItems": true}
      }}},
    "modelBindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "provider", "model", "credentialEnv"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}, "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "model": {"type": "string", "minLength": 1}, "credentialEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$"},
        "endpoints": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
          "openaiChat": {"type": "string", "minLength": 1}, "anthropic": {"type": "string", "minLength": 1},
          "responses": {"type": "string", "minLength": 1}
        }}
      }}},
    "git": {"type": "object", "additionalProperties": false, "required": ["localCommits", "remoteWrites"], "properties": {
      "localCommits": {"const": true}, "remoteWrites": {"enum": ["none", "push"]}
    }},
    "inputHosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "artifactConnectors": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "uriPrefix", "getArgv"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "uriPrefix": {"type": "string", "minLength": 4},
        "getArgv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "putArgv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "passEnv": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}, "uniqueItems": true},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }}},
    "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "argv", "repositories"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "repositories": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }}},
    "skills": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "path"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64}, "path": {"type": "string"}}}},
    "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "argv"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}, "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "path": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "passEnv": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$"}, "uniqueItems": true},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 600}
      }}},
    "toolSearch": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {
      "mode": {"enum": ["lexical", "llm-rerank"]},
      "modelBinding": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"}
    }}
  }
}
