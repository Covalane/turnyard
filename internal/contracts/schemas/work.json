{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "idempotencyKey", "objective", "scope", "acceptance", "checks"],
  "anyOf": [
    {"properties": {"checks": {"minItems": 1}}},
    {"required": ["deliverables"], "properties": {"deliverables": {"minItems": 1}}}
  ],
  "properties": {
    "schemaVersion": {"const": "turnyard.work/v1"},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 120},
    "objective": {"type": "string", "minLength": 1},
    "commitMessage": {"type": "string", "minLength": 1, "maxLength": 80},
    "scope": {"type": "object", "additionalProperties": false, "required": ["repositories"], "properties": {
      "repositories": {"type": "array", "items": {"type": "object", "additionalProperties": false,
        "required": ["id", "mode"], "properties": {
          "id": {"type": "string"}, "mode": {"enum": ["read", "write"]}
        }}}
    }},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "source"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "source": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {
          "kind": {"enum": ["file", "https", "connector"]},
          "path": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "connector": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1}
        }},
        "expectedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mediaType": {"type": "string", "minLength": 1}
      }}},
    "deliverables": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind"], "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
        "repository": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "image", "text", "pull_request"]},
        "expectedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mediaType": {"type": "string", "minLength": 1},
        "base": {"type": "string", "minLength": 1},
        "destination": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {
          "kind": {"enum": ["local", "connector"]},
          "connector": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1}
        }}
      }}}
  }
}
